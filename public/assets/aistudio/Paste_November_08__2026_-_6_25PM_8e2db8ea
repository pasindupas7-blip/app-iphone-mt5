    private fun normalizeSymbol(symbol: String): String =
        symbol.trim().uppercase(Locale.US).replace("/", "")

    private fun getSymbolMeta(symbol: String): SymbolMeta {
        val norm = normalizeSymbol(symbol)
        symbolCatalog[norm]?.let { return it }

        val quoteCurrency = if (norm.length >= 6) norm.substring(3, 6) else "USD"
        val isJpy = quoteCurrency == "JPY"
        val isMetalOrCrypto = norm.startsWith("XAU") || norm.startsWith("XAG") || norm.startsWith("BTC") || norm.startsWith("ETH")
        val digits = when {
            isMetalOrCrypto -> 2
            isJpy -> 3
            else -> 5
        }
        val pointSize = 10.0.pow(-digits.toDouble())
        val base = if (norm.length >= 3) norm.substring(0, 3) else norm
        return SymbolMeta(
            symbol = norm,
            description = "$base vs $quoteCurrency",
            digits = digits,
            pointSize = pointSize,
            defaultSpreadPoints = if (isMetalOrCrypto) 24 else 14
        )
    }

    fun getLivePrice(symbol: String): Double {
        val norm = normalizeSymbol(symbol)
        return liveDisplayedRates[norm]
            ?: liveServerRates[norm]
            ?: initialFallbackPrices[norm]
            ?: 1.00000
    }

    fun buildInstantQuote(symbol: String): SymbolQuote {
        val norm = normalizeSymbol(symbol)
        val meta = getSymbolMeta(norm)
        val bid = roundToDigits(getLivePrice(norm), meta.digits)
        val spread = meta.defaultSpreadPoints * meta.pointSize
        val ask = roundToDigits(bid + spread, meta.digits)
        val extrema = dailyExtrema[norm]
        val low = roundToDigits(min(extrema?.first ?: bid, bid), meta.digits)
        val high = roundToDigits(max(extrema?.second ?: ask, ask), meta.digits)

        val quote = SymbolQuote(
            symbol = meta.symbol,
            description = meta.description,
            bid = bid,
            ask = ask,
            low = low,
            high = high,
            digits = meta.digits,
            spread = meta.defaultSpreadPoints,
            changePercent = 0.0,
            lastDirection = 0,
            timestamp = formatCurrentTime()
        )
        prevQuotes[norm] = quote
        return quote
    }

    fun streamQuotes(symbols: List<String> = WATCHLIST_SYMBOLS): Flow<List<SymbolQuote>> = flow {
        var tickCounter = 0L
        var lastFullRefreshMs = 0L

        while (currentCoroutineContext().isActive) {
            val activeSymbols = symbols.map { normalizeSymbol(it) }.distinct()
            val marketOpenNow = SriLankaMarketHours.isMarketOpen()
            val nowMs = System.currentTimeMillis()

            if (marketOpenNow && (lastFullRefreshMs == 0L || nowMs - lastFullRefreshMs >= 2_200L)) {
                refreshLiveMarketRates(activeSymbols)
                lastFullRefreshMs = nowMs
            } else if (marketOpenNow && tickCounter % 2L == 1L) {
                fetchRealTimeGoldAndBitcoinRates(activeSymbols)
            }

            if (lastFullRefreshMs == 0L && !marketOpenNow) {
                refreshLiveMarketRates(activeSymbols)
                lastFullRefreshMs = nowMs
            }

            val updatedQuotes = activeSymbols.map { sym ->
                createTickQuote(sym, marketOpenNow)
            }
            emit(updatedQuotes)

            tickCounter++
            delay(500L)
        }
    }.flowOn(ioDispatcher)

    private fun refreshLiveMarketRates(symbols: List<String>) {
        try {
            fetchRealTimeGoldAndBitcoinRates(symbols)

            val usdTargets = mutableSetOf<String>()
            val nonUsdPairs = mutableListOf<String>()

            for (sym in symbols) {
                if (sym == "XAUUSD" || sym == "BTCUSD" || sym == "NDX100" || sym == "NAS100") continue
                val parsed = parseSymbol(sym) ?: continue
                val (from, to) = parsed
                if (from == "USD") {
                    usdTargets.add(to)
                } else if (to == "USD") {
                    usdTargets.add(from)
                } else {
                    usdTargets.add(from)
                    usdTargets.add(to)
                    nonUsdPairs.add(sym)
                }
            }

            if (usdTargets.isNotEmpty()) {
                val currenciesParam = usdTargets.joinToString(",")
                val url = "$BASE_URL/fetch-multi?from=USD&to=$currenciesParam&api_key=$apiKey"
                val request = Request.Builder()
                    .url(url)
                    .header("User-Agent", USER_AGENT)
                    .get()
                    .build()

                okHttpClient.newCall(request).execute().use { response ->
                    if (response.isSuccessful) {
                        val body = response.body?.string()
                        if (!body.isNullOrEmpty()) {
                            val json = JSONObject(body)
                            val results = json.optJSONObject("results")
                            if (results != null) {
                                applyUsdMultiResults(symbols, results)
                            }
                        }
                    }
                }
            }

            for (crossSym in nonUsdPairs) {
                fetchOnePairRate(crossSym)?.let { rate ->
                    updateLiveServerRate(crossSym, rate)
                }
            }

            for (sym in symbols) {
                if (sym == "XAUUSD" || sym == "BTCUSD" || sym == "NDX100" || sym == "NAS100") continue
                fetchYahooSpotPrice(toYahooTicker(sym))?.let { yahooRate ->
                    if (yahooRate > 0.0) {
                        updateLiveServerRate(sym, yahooRate)
                    }
                }
            }
        } catch (e: Exception) {
            Log.d(TAG, "FastForex network refresh error: ${e.message}")
        }
    }

    private fun fetchRealTimeGoldAndBitcoinRates(symbols: List<String>) {
        if (symbols.contains("XAUUSD")) {
            val goldPrice = fetchYahooSpotPrice("XAUUSD=X")
                ?: fetchYahooSpotPrice("GC=F")
                ?: fetchBinanceTickerPrice("PAXGUSDT")
                ?: fetchOnePairRate("XAUUSD")
            if (goldPrice != null && goldPrice > 500.0) {
                updateLiveServerRate("XAUUSD", goldPrice)
            }
        }

        if (symbols.contains("NDX100") || symbols.contains("NAS100")) {
            val ndxPrice = fetchYahooSpotPrice("^NDX")
                ?: fetchYahooSpotPrice("NQ=F")
            if (ndxPrice != null && ndxPrice > 1000.0) {
                if (symbols.contains("NDX100")) updateLiveServerRate("NDX100", ndxPrice)
                if (symbols.contains("NAS100")) updateLiveServerRate("NAS100", ndxPrice)
            }
        }

        if (symbols.contains("BTCUSD")) {
            val btcPrice = fetchBinanceTickerPrice("BTCUSDT")
                ?: fetchYahooSpotPrice("BTC-USD")
                ?: fetchOnePairRate("BTCUSD")
            if (btcPrice != null && btcPrice > 1000.0) {
                updateLiveServerRate("BTCUSD", btcPrice)
            }
        }
    }

    private fun fetchBinanceTickerPrice(binanceSymbol: String): Double? {
        val endpoints = listOf(
            "https://data-api.binance.vision/api/v3/bookTicker?symbol=$binanceSymbol",
            "https://api.binance.com/api/v3/bookTicker?symbol=$binanceSymbol"
        )
        for (url in endpoints) {
            try {
                val request = Request.Builder()
                    .url(url)
                    .header("User-Agent", USER_AGENT)
                    .get()
                    .build()
                okHttpClient.newCall(request).execute().use { response ->
                    if (!response.isSuccessful) return@use
                    val body = response.body?.string() ?: return@use
                    val json = JSONObject(body)
                    val bidPrice = json.optString("bidPrice", "").toDoubleOrNull()
                    if (bidPrice != null && bidPrice > 0.0) {
                        return bidPrice
                    }
                }
            } catch (_: Exception) {
            }
        }
        return null
    }

    private fun fetchYahooSpotPrice(yahooTicker: String): Double? {
        val urls = listOf(
            "https://query1.finance.yahoo.com/v8/finance/chart/$yahooTicker?interval=1m&range=1d",
            "https://query2.finance.yahoo.com/v8/finance/chart/$yahooTicker?interval=1m&range=1d"
        )
        for (url in urls) {
            try {
                val request = Request.Builder()
                    .url(url)
                    .header("User-Agent", USER_AGENT)
                    .get()
                    .build()
                okHttpClient.newCall(request).execute().use { response ->
                    if (!response.isSuccessful) return@use
                    val body = response.body?.string() ?: return@use
                    val root = JSONObject(body)
                    val resultArr = root.optJSONObject("chart")?.optJSONArray("result") ?: return@use
                    if (resultArr.length() == 0) return@use
                    val resultObj = resultArr.optJSONObject(0) ?: return@use
                    val meta = resultObj.optJSONObject("meta")
                    val regularMarketPrice = meta?.optDouble("regularMarketPrice", 0.0) ?: 0.0
                    if (regularMarketPrice > 0.0 && !regularMarketPrice.isNaN()) {
                        return regularMarketPrice
                    }
                }
            } catch (_: Exception) {
            }
        }
        return null
    }

    private fun toYahooTicker(symbol: String): String {
        return when (val norm = normalizeSymbol(symbol)) {
            "XAUUSD" -> "GC=F"
            "NDX100", "NAS100" -> "^NDX"
            "BTCUSD" -> "BTC-USD"
            "EURUSD" -> "EURUSD=X"
            "GBPUSD" -> "GBPUSD=X"
            "USDJPY" -> "JPY=X"
            "USDCHF" -> "CHF=X"
            "AUDUSD" -> "AUDUSD=X"
            "USDCAD" -> "CAD=X"
            "NZDUSD" -> "NZDUSD=X"
            "USDSEK" -> "SEK=X"
            "USDCNH" -> "CNH=X"
            else -> "${norm}=X"
        }
    }

    private fun applyUsdMultiResults(symbols: List<String>, results: JSONObject) {
        for (sym in symbols) {
            if (sym == "XAUUSD" || sym == "BTCUSD" || sym == "NDX100" || sym == "NAS100") continue
            val (from, to) = parseSymbol(sym) ?: continue
            val rate: Double? = when {
                from == "USD" && results.has(to) -> {
                    val r = results.optDouble(to, 0.0)
                    if (r > 0.0) r else null
                }
                to == "USD" && results.has(from) -> {
                    val usdToFrom = results.optDouble(from, 0.0)
                    if (usdToFrom > 0.0) 1.0 / usdToFrom else null
                }
                results.has(from) && results.has(to) -> {
                    val usdToFrom = results.optDouble(from, 0.0)
                    val usdToTo = results.optDouble(to, 0.0)
                    if (usdToFrom > 0.0 && usdToTo > 0.0) usdToTo / usdToFrom else null
                }
                else -> null
            }
            if (rate != null && rate > 0.0) {
                updateLiveServerRate(sym, rate)
            }
        }
    }

    private fun fetchOnePairRate(symbol: String): Double? {
        val (from, to) = parseSymbol(symbol) ?: return null
        return try {
            val url = "$BASE_URL/fetch-one?from=$from&to=$to&api_key=$apiKey"
            val request = Request.Builder()
                .url(url)
                .header("User-Agent", USER_AGENT)
                .get()
                .build()
            okHttpClient.newCall(request).execute().use { response ->
                if (!response.isSuccessful) return null
                val body = response.body?.string() ?: return null
                val json = JSONObject(body)
                val resultObj = json.optJSONObject("result") ?: return null
                val rate = resultObj.optDouble(to, 0.0)
                if (rate > 0.0) rate else null
            }
        } catch (e: Exception) {
            null
        }
    }

    private fun updateLiveServerRate(symbol: String, rawRate: Double) {
        val norm = normalizeSymbol(symbol)
        val meta = getSymbolMeta(norm)
        val cleanRate = roundToDigits(rawRate, meta.digits)
        if (cleanRate <= 0.0) return

        val prevServer = liveServerRates[norm]
        liveServerRates[norm] = cleanRate

        val curDisp = liveDisplayedRates[norm]
        if (curDisp == null || prevServer == null || abs(cleanRate - curDisp) > cleanRate * 0.0025) {
            liveDisplayedRates[norm] = cleanRate
        }

        val currentExtrema = dailyExtrema[norm]
        if (currentExtrema == null) {
            val range = meta.pointSize * meta.defaultSpreadPoints * 8.0
            dailyExtrema[norm] = Pair(cleanRate - range, cleanRate + range)
        } else {
            dailyExtrema[norm] = Pair(
                min(currentExtrema.first, cleanRate),
                max(currentExtrema.second, cleanRate)
            )
        }
    }

    private fun createTickQuote(symbol: String, isMarketOpenNow: Boolean = SriLankaMarketHours.isMarketOpen()): SymbolQuote {
        val norm = normalizeSymbol(symbol)
        val meta = getSymbolMeta(norm)
        val serverAnchor = liveServerRates[norm] ?: initialFallbackPrices[norm] ?: 1.00000
        val currentDisp = liveDisplayedRates[norm] ?: serverAnchor

        if (!isMarketOpenNow) {
            val closedTimeMs = SriLankaMarketHours.clampToLastOpenMarketTimestamp()
            val bid = roundToDigits(currentDisp, meta.digits)
            val spread = meta.defaultSpreadPoints * meta.pointSize
            val ask = roundToDigits(bid + spread, meta.digits)
            val prev = prevQuotes[norm]
            val extrema = dailyExtrema[norm]
            val low = roundToDigits(min(extrema?.first ?: bid, bid), meta.digits)
            val high = roundToDigits(max(extrema?.second ?: ask, ask), meta.digits)

            val closedQuote = SymbolQuote(
                symbol = meta.symbol,
                description = meta.description,
                bid = bid,
                ask = ask,
                low = low,
                high = high,
                digits = meta.digits,
                spread = meta.defaultSpreadPoints,
                changePercent = prev?.changePercent ?: 0.0,
                lastDirection = 0,
                timestamp = formatTimeAt(closedTimeMs)
            )
            prevQuotes[norm] = closedQuote
            return closedQuote
        }

        val driftToServer = (serverAnchor - currentDisp) * 0.55
        val microTickStep = when (norm) {
            "XAUUSD" -> Random.nextDouble(-0.18, 0.18)
            "NDX100", "NAS100" -> Random.nextDouble(-1.40, 1.40)
            "BTCUSD" -> Random.nextDouble(-6.50, 6.50)
            else -> Random.nextInt(-3, 4) * meta.pointSize
        }

        val maxDeviationFromServer = when (norm) {
            "XAUUSD" -> 0.45
            "NDX100", "NAS100" -> 3.50
            "BTCUSD" -> 18.00
            else -> meta.pointSize * 12.0
        }
        val unclampedBid = currentDisp + driftToServer + microTickStep
        val rawBid = unclampedBid.coerceIn(
            (serverAnchor - maxDeviationFromServer).coerceAtLeast(meta.pointSize),
            serverAnchor + maxDeviationFromServer
        )
        val bid = roundToDigits(rawBid, meta.digits)
        liveDisplayedRates[norm] = bid

        val spreadDynamic = (meta.defaultSpreadPoints + Random.nextInt(-1, 2)).coerceAtLeast(1)
        val ask = roundToDigits(bid + spreadDynamic * meta.pointSize, meta.digits)

        candleAggregator.onPriceTick(norm, bid)

        val extrema = dailyExtrema[norm]
        val low = roundToDigits(min(extrema?.first ?: bid, bid), meta.digits)
        val high = roundToDigits(max(extrema?.second ?: ask, ask), meta.digits)
        dailyExtrema[norm] = Pair(low, high)

        val prev = prevQuotes[norm]
        val direction = when {
            prev == null -> 1
            bid > prev.bid -> 1
            bid < prev.bid -> -1
            else -> prev.lastDirection
        }

        val openRef = initialFallbackPrices[norm] ?: serverAnchor
        val changePct = if (openRef > 0.0) {
            round(((bid - openRef) / openRef) * 10000.0) / 100.0
        } else {
            0.0
        }

        val quote = SymbolQuote(
            symbol = meta.symbol,
            description = meta.description,
            bid = bid,
            ask = ask,
            low = low,
            high = high,
            digits = meta.digits,
            spread = spreadDynamic,
            changePercent = changePct,
            lastDirection = direction,
            timestamp = formatCurrentTime()
        )
        prevQuotes[norm] = quote
        return quote
    }

    private fun parseSymbol(symbol: String): Pair<String, String>? {
        val clean = normalizeSymbol(symbol)
        if (clean.length < 6) return null
        val from = clean.substring(0, 3)
        val to = clean.substring(3, 6)
        return Pair(from, to)
    }

    private fun roundToDigits(value: Double, digits: Int): Double {
        val factor = 10.0.pow(digits.toDouble())
        return round(value * factor) / factor
    }

    private val timeFormat = SimpleDateFormat("HH:mm:ss", Locale.US).apply {
        timeZone = SriLankaMarketHours.SRI_LANKA_TIME_ZONE
    }

    private fun formatCurrentTime(): String {
        return formatTimeAt(SriLankaMarketHours.clampToLastOpenMarketTimestamp(SriLankaMarketHours.chartNowMillis()))
    }

    private fun formatTimeAt(timestampMs: Long): String {
        return synchronized(dateFormatLock) {
            timeFormat.format(Date(timestampMs))
        }
    }

    suspend fun fetch14DayCandles(
        symbol: String,
        timeframe: Timeframe,
        fallbackLivePrice: Double
    ): List<Candle> {
        val normSym = normalizeSymbol(symbol)

        if (normSym == "BTCUSD") {
            val binanceCandles = fetchBinanceCandlesAllTimeframes(normSym, timeframe)
            if (binanceCandles.size >= 15) {
                val realLatestClose = binanceCandles.last().close
                if (realLatestClose > 0.0 && timeframe == Timeframe.M1) {
                    updateLiveServerRate(normSym, realLatestClose)
                }
                return binanceCandles
            }
        }

        val yahooCandles = fetchYahooCandles(normSym, timeframe)
        if (yahooCandles.size >= 10) {
            val realLatestClose = yahooCandles.last().close
            if (realLatestClose > 0.0 && timeframe == Timeframe.M1) {
                updateLiveServerRate(normSym, realLatestClose)
            }
            return yahooCandles
        }

        if (normSym == "XAUUSD") {
            val binanceCandles = fetchBinanceCandlesAllTimeframes(normSym, timeframe)
            if (binanceCandles.size >= 15) {
                val realLatestClose = binanceCandles.last().close
                if (realLatestClose > 0.0 && timeframe == Timeframe.M1) {
                    updateLiveServerRate(normSym, realLatestClose)
                }
                return binanceCandles
            }
        }

        val effectiveAnchor = if (fallbackLivePrice > 0.0) fallbackLivePrice else getLivePrice(normSym)
        return build14DayCandlesFromAnchors(normSym, timeframe, effectiveAnchor, emptyList())
    }
