package com.example.data

import android.content.Context
import android.util.Log
import com.example.R
import com.example.model.AccountInfo
import com.example.model.HistoryTrade
import com.example.model.TradePosition
import com.google.firebase.Firebase
import com.google.firebase.FirebaseApp
import com.google.firebase.Timestamp
import com.google.firebase.auth.FirebaseAuth
import com.google.firebase.firestore.DocumentSnapshot
import com.google.firebase.firestore.FieldValue
import com.google.firebase.firestore.FirebaseFirestore
import com.google.firebase.firestore.ListenerRegistration
import com.google.firebase.firestore.SetOptions
import com.google.firebase.firestore.firestore
import kotlinx.coroutines.channels.awaitClose
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.callbackFlow
import kotlinx.coroutines.tasks.await

/**
 * Cloud Firestore repository for syncing user-owned trading accounts, open positions, and closed trade history.
 */
class CloudTradeRepository(
    context: Context? = null,
    private val firestoreInstance: FirebaseFirestore? = null,
    private val authInstance: FirebaseAuth? = null
) {
    private val appContext: Context? = context?.applicationContext

    private val auth: FirebaseAuth? by lazy {
        authInstance ?: try {
            if (FirebaseApp.getApps(appContext ?: return@lazy null).isNotEmpty()) {
                FirebaseAuth.getInstance()
            } else {
                null
            }
        } catch (e: Exception) {
            Log.w(TAG, "FirebaseAuth not initialized: ${e.message}")
            null
        }
    }

    private val db: FirebaseFirestore? by lazy {
        firestoreInstance ?: try {
            val ctx = appContext ?: return@lazy null
            if (FirebaseApp.getApps(ctx).isEmpty()) return@lazy null
            val dbId = try {
                ctx.getString(R.string.firebase_Firestore_database_id)
            } catch (_: Exception) {
                ""
            }
            if (dbId.isNotBlank() && dbId != "(default)") {
                Firebase.firestore(dbId)
            } else {
                Firebase.firestore
            }
        } catch (e: Exception) {
            Log.w(TAG, "Firestore not initialized: ${e.message}")
            null
        }
    }

    val currentUserId: String?
        get() = auth?.currentUser?.uid

    private fun positionDocPrefix(accountDocId: String): String {
        return if (accountDocId == "main") "pos_" else "pos_${accountDocId}_"
    }

    private fun historyDocPrefix(accountDocId: String): String {
        return if (accountDocId == "main") "hist_" else "hist_${accountDocId}_"
    }

    private fun isDocForAccount(docId: String, accountDocId: String, mainPrefix: String): Boolean {
        return if (accountDocId == "main") {
            docId.startsWith(mainPrefix) && !docId.removePrefix(mainPrefix).startsWith("acc_")
        } else {
            docId.startsWith("${mainPrefix}${accountDocId}_")
        }
    }

    fun observeOpenPositions(userId: String, accountDocId: String = "main"): Flow<List<TradePosition>> = callbackFlow {
        val firestore = db
        if (firestore == null || userId.isBlank()) {
            trySend(emptyList())
            close()
            return@callbackFlow
        }

        val registration: ListenerRegistration = firestore
            .collection("users")
            .document(userId)
            .collection("positions")
            .addSnapshotListener { snapshot, error ->
                if (error != null) {
                    Log.w(TAG, "Positions listener error: ${error.message}")
                    return@addSnapshotListener
                }
                if (snapshot != null) {
                    val list = snapshot.documents
                        .filter { isDocForAccount(it.id, accountDocId, "pos_") }
                        .mapNotNull { doc -> doc.toTradePosition() }
                    trySend(list)
                }
            }

        awaitClose { registration.remove() }
    }

    fun observeHistoryTrades(userId: String, accountDocId: String = "main"): Flow<List<HistoryTrade>> = callbackFlow {
        val firestore = db
        if (firestore == null || userId.isBlank()) {
            trySend(emptyList())
            close()
            return@callbackFlow
        }

        val registration: ListenerRegistration = firestore
            .collection("users")
            .document(userId)
            .collection("history")
            .addSnapshotListener { snapshot, error ->
                if (error != null) {
                    Log.w(TAG, "History listener error: ${error.message}")
                    return@addSnapshotListener
                }
                if (snapshot != null) {
                    val list = snapshot.documents
                        .filter { isDocForAccount(it.id, accountDocId, "hist_") }
                        .mapNotNull { doc -> doc.toHistoryTrade() }
                        .sortedByDescending { it.id }
                    trySend(list)
                }
            }

        awaitClose { registration.remove() }
    }

    fun observeAccountInfo(userId: String, accountDocId: String = "main"): Flow<AccountInfo?> = callbackFlow {
        val firestore = db
        if (firestore == null || userId.isBlank()) {
            trySend(null)
            close()
            return@callbackFlow
        }

        val registration: ListenerRegistration = firestore
            .collection("users")
            .document(userId)
            .collection("accounts")
            .document(accountDocId)
            .addSnapshotListener { snapshot, error ->
                if (error != null) {
                    Log.w(TAG, "Account listener error: ${error.message}")
                    return@addSnapshotListener
                }
                if (snapshot != null && snapshot.exists()) {
                    trySend(snapshot.toAccountInfo())
                } else {
                    trySend(null)
                }
            }

        awaitClose { registration.remove() }
    }

    fun observeAllAccounts(userId: String): Flow<List<Pair<String, AccountInfo>>> = callbackFlow {
        val firestore = db
        if (firestore == null || userId.isBlank()) {
            trySend(emptyList())
            close()
            return@callbackFlow
        }

        val registration: ListenerRegistration = firestore
            .collection("users")
            .document(userId)
            .collection("accounts")
            .addSnapshotListener { snapshot, error ->
                if (error != null) {
                    Log.w(TAG, "All accounts listener error: ${error.message}")
                    return@addSnapshotListener
                }
                if (snapshot != null) {
                    val list = snapshot.documents.mapNotNull { doc ->
                        val info = doc.toAccountInfo()
                        if (info != null) Pair(doc.id, info) else null
                    }
                    trySend(list)
                }
            }

        awaitClose { registration.remove() }
    }

    suspend fun deleteAccount(userId: String, accountDocId: String) {
        val firestore = db ?: return
        if (userId.isBlank() || accountDocId.isBlank()) return
        try {
            val userRef = firestore.collection("users").document(userId)

            val posSnap = userRef.collection("positions").get().await()
            for (doc in posSnap.documents) {
                if (isDocForAccount(doc.id, accountDocId, "pos_")) {
                    doc.reference.delete().await()
                }
            }

            val histSnap = userRef.collection("history").get().await()
            for (doc in histSnap.documents) {
                if (isDocForAccount(doc.id, accountDocId, "hist_")) {
                    doc.reference.delete().await()
                }
            }

            userRef.collection("accounts").document(accountDocId).delete().await()
        } catch (e: Exception) {
            Log.w(TAG, "Failed to delete account $accountDocId: ${e.message}")
        }
    }

    suspend fun clearHistoryForAccount(userId: String, accountDocId: String = "main") {
        val firestore = db ?: return
        if (userId.isBlank() || accountDocId.isBlank()) return
        try {
            val userRef = firestore.collection("users").document(userId)
            val histSnap = userRef.collection("history").get().await()
            for (doc in histSnap.documents) {
                if (isDocForAccount(doc.id, accountDocId, "hist_")) {
                    doc.reference.delete().await()
                }
            }
        } catch (e: Exception) {
            Log.w(TAG, "Failed to clear history for account $accountDocId: ${e.message}")
        }
    }

    suspend fun upsertPosition(userId: String, position: TradePosition, accountDocId: String = "main") {
        val firestore = db ?: return
        if (userId.isBlank()) return
        val docRef = firestore
            .collection("users")
            .document(userId)
            .collection("positions")
            .document("${positionDocPrefix(accountDocId)}${position.id}")

        try {
            val existing = docRef.get().await()
            val payload = hashMapOf<String, Any?>(
                "userId" to userId,
                "ticketId" to position.ticketId.take(40).ifBlank { position.id.toString() },
                "symbol" to position.symbol.take(20),
                "isBuy" to position.isBuy,
                "lots" to position.lots.coerceIn(0.01, 1000.0),
                "openPrice" to position.openPrice.coerceAtLeast(0.0),
                "currentPrice" to position.currentPrice.coerceAtLeast(0.0),
                "profit" to position.profit,
                "openTime" to position.openTime.take(64).ifBlank { "2025.05.12 08:00:00" },
                "updatedAt" to FieldValue.serverTimestamp()
            )
            if (position.sl != null && position.sl > 0.0) {
                payload["sl"] = position.sl
            } else {
                payload["sl"] = null
            }
            if (position.tp != null && position.tp > 0.0) {
                payload["tp"] = position.tp
            } else {
                payload["tp"] = null
            }

            if (existing.exists()) {
                val createdAt = existing.getTimestamp("createdAt") ?: Timestamp.now()
                payload["createdAt"] = createdAt
                docRef.set(payload).await()
            } else {
                payload["createdAt"] = FieldValue.serverTimestamp()
                docRef.set(payload).await()
            }
        } catch (e: Exception) {
            Log.w(TAG, "Failed to upsert position ${position.id}: ${e.message}")
        }
    }

    suspend fun deletePosition(userId: String, positionId: Long, accountDocId: String = "main") {
        val firestore = db ?: return
        if (userId.isBlank()) return
        try {
            firestore
                .collection("users")
                .document(userId)
                .collection("positions")
                .document("${positionDocPrefix(accountDocId)}$positionId")
                .delete()
                .await()
        } catch (e: Exception) {
            Log.w(TAG, "Failed to delete position $positionId: ${e.message}")
        }
    }

