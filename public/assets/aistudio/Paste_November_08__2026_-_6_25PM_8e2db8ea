@Composable
fun ChartScreen(
    quote: SymbolQuote,
    allQuotes: List<SymbolQuote>,
    candles: List<Candle>,
    positions: List<TradePosition>,
    historyTrades: List<HistoryTrade> = emptyList(),
    selectedTimeframe: Timeframe,
    lotSize: Double,
    isDarkMode: Boolean,
    showMA: Boolean,
    maPeriod: Int,
    showCrosshair: Boolean,
    showGrid: Boolean,
    showSymbolDescription: Boolean = true,
    fit14DaysMode: Boolean = false,
    onFit14DaysChange: (Boolean) -> Unit = {},
    enableHistoryTradeMove: Boolean = true,
    onToggleHistoryTradeMove: () -> Unit = {},
    viewportState: ChartViewportState = ChartViewportState(),
    onViewportStateChange: (ChartViewportState) -> Unit = {},
    onSelectSymbol: (String) -> Unit,
    onSelectTimeframe: (Timeframe) -> Unit,
    onAdjustLot: (Double) -> Unit,
    onSetLotSize: (Double) -> Unit,
    onQuickBuy: () -> Unit,
    onQuickSell: () -> Unit,
    onOpenOrderScreen: () -> Unit,
    onToggleDarkMode: () -> Unit,
    onToggleMA: () -> Unit,
    onUpdateMAPeriod: (Int) -> Unit,
    onToggleCrosshair: () -> Unit,
    onToggleGrid: () -> Unit,
    onToggleSymbolDescription: () -> Unit = {},
    onCalculateHistoryProfit: (isBuy: Boolean, lots: Double, openPrice: Double, closePrice: Double) -> Double = { _, _, _, _ -> 0.0 },
    onSaveHistoryTradeEdit: (
        trade: HistoryTrade,
        isBuy: Boolean,
        openPrice: Double,
        closePrice: Double,
        openTime: String,
        closeTime: String
    ) -> Unit = { _, _, _, _, _, _ -> },
    onSaveRunningPositionEdit: (
        position: TradePosition,
        isBuy: Boolean,
        openPrice: Double,
        openTime: String
    ) -> Unit = { _, _, _, _ -> },
    onOpenDrawer: () -> Unit
) {
    var showQuickTradeBar by remember { mutableStateOf(false) }
    var showTimeframeSelectorPopup by remember { mutableStateOf(false) }
    var showSymbolMenu by remember { mutableStateOf(false) }
    var showOptionsMenu by remember { mutableStateOf(false) }
    var showMADialog by remember { mutableStateOf(false) }
    var maInputText by remember(maPeriod) { mutableStateOf(maPeriod.toString()) }

    val topBarBg = if (isDarkMode) Color(0xFF141922) else Color.White
    val primaryIconTint = if (isDarkMode) Color(0xFFE5E7EB) else Color(0xFF3A3F47)
    val dividerColor = if (isDarkMode) Color(0xFF222731) else Color(0xFFE8EAED)

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(if (isDarkMode) Color(0xFF000000) else Color.White)
            .testTag("chart_screen")
    ) {
        Column(modifier = Modifier.fillMaxSize()) {
            Surface(
                color = topBarBg,
                shadowElevation = 0.dp,
                modifier = Modifier.fillMaxWidth()
            ) {
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .height(48.dp)
                        .padding(horizontal = 4.dp),
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    IconButton(
                        onClick = onOpenDrawer,
                        modifier = Modifier.testTag("chart_menu_button")
                    ) {
                        Icon(
                            imageVector = Icons.Default.Menu,
                            contentDescription = stringResource(R.string.cd_menu),
                            tint = primaryIconTint
                        )
                    }

                    Row(
                        modifier = Modifier
                            .weight(1f)
                            .fillMaxWidth(),
                        horizontalArrangement = Arrangement.SpaceEvenly,
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        IconButton(
                            onClick = onToggleCrosshair,
                            modifier = Modifier.testTag("chart_crosshair_button")
                        ) {
                            CrosshairToolbarIcon(
                                tint = if (showCrosshair) MT5Blue else primaryIconTint
                            )
                        }

                        IconButton(
                            onClick = { showMADialog = true },
                            modifier = Modifier.testTag("chart_indicator_button")
                        ) {
                            Text(
                                text = "f",
                                fontFamily = FontFamily.Serif,
                                fontStyle = FontStyle.Italic,
                                fontWeight = FontWeight.Normal,
                                fontSize = 22.sp,
                                color = if (showMA) MT5Blue else primaryIconTint
                            )
                        }

                        Box {
                            IconButton(
                                onClick = { showSymbolMenu = true },
                                modifier = Modifier.testTag("chart_symbol_Cycle_button")
                            ) {
                                DollarSymbolToolbarIcon(tint = primaryIconTint)
                            }

                            DropdownMenu(
                                expanded = showSymbolMenu,
                                onDismissRequest = { showSymbolMenu = false }
                            ) {
                                allQuotes.forEach { item ->
                                    DropdownMenuItem(
                                        text = {
                                            Row(
                                                modifier = Modifier.fillMaxWidth(),
                                                horizontalArrangement = Arrangement.SpaceBetween,
                                                verticalAlignment = Alignment.CenterVertically
                                            ) {
                                                Text(
                                                    text = item.symbol,
                                                    fontWeight = if (item.symbol == quote.symbol) FontWeight.Bold else FontWeight.Normal,
                                                    color = if (item.symbol == quote.symbol) MT5Blue else Color.Unspecified
                                                )
                                                Spacer(modifier = Modifier.width(12.dp))
                                                Text(
                                                    text = String.format(Locale.US, "%.${item.digits}f", item.bid),
                                                    fontSize = 12.sp,
                                                    color = Color(0xFF6B7280)
                                                )
                                            }
                                        },
                                        onClick = {
                                            onSelectSymbol(item.symbol)
                                            showSymbolMenu = false
                                        },
                                        modifier = Modifier.testTag("chart_symbol_item_${item.symbol}")
                                    )
                                }
                            }
                        }

                        IconButton(
                            onClick = { showTimeframeSelectorPopup = !showTimeframeSelectorPopup },
                            modifier = Modifier.testTag("chart_clock_timeframe_button")
                        ) {
                            ClockTimeframeToolbarIcon(
                                tint = if (showTimeframeSelectorPopup) MT5Blue else primaryIconTint
                            )
                        }

                        IconButton(
                            onClick = { showQuickTradeBar = !showQuickTradeBar },
                            modifier = Modifier.testTag("chart_toggle_quick_trade_button")
                        ) {
                            OneClickTradeToolbarIcon(
                                isActive = showQuickTradeBar,
                                normalTint = primaryIconTint
                            )
                        }
                    }

                    IconButton(
                        onClick = onOpenOrderScreen,
                        modifier = Modifier
                            .padding(end = 2.dp)
                            .testTag("chart_new_order_button")
                    ) {
                        NewOrderPlusToolbarIcon()
                    }
                }
            }

            HorizontalDivider(color = dividerColor, thickness = 0.7.dp)

            if (showQuickTradeBar) {
                QuickTradeBar(
                    symbol = quote.symbol,
                    bid = quote.bid,
                    ask = quote.ask,
                    digits = quote.digits,
                    lotSize = lotSize,
                    onDecreaseLot = { onAdjustLot(-0.01) },
                    onIncreaseLot = { onAdjustLot(0.01) },
                    onSetLotSize = onSetLotSize,
                    onSellClick = onQuickSell,
                    onBuyClick = onQuickBuy
                )
                HorizontalDivider(color = dividerColor, thickness = 0.7.dp)
            }

            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .weight(1f)
            ) {
                CandlestickChart(
                    quote = quote,
                    candles = candles,
                    positions = positions,
                    historyTrades = historyTrades,
                    timeframeLabel = selectedTimeframe.label,
                    isDarkMode = isDarkMode,
                    showMA = showMA,
                    maPeriod = maPeriod,
                    showCrosshair = showCrosshair,
                    showGrid = showGrid,
                    showSymbolDescription = showSymbolDescription,
                    fit14DaysMode = fit14DaysMode,
                    onFit14DaysChange = onFit14DaysChange,
                    enableHistoryTradeMove = enableHistoryTradeMove,
                    initialViewportState = viewportState,
                    onViewportStateChange = onViewportStateChange,
                    onSymbolClick = { showSymbolMenu = true },
                    onMoreOptionsClick = { showOptionsMenu = true },
                    onCanvasTouch = {
                        if (showTimeframeSelectorPopup) {
                            showTimeframeSelectorPopup = false
                        }
                    },
                    onCalculateHistoryProfit = onCalculateHistoryProfit,
                    onSaveHistoryTradeEdit = onSaveHistoryTradeEdit,
                    onSaveRunningPositionEdit = onSaveRunningPositionEdit,
                    modifier = Modifier.fillMaxSize()
                )
            }
        }
    }
}
