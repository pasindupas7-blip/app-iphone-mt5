    init {
        val seedNow = SriLankaMarketHours.chartNowMillis()
        for ((sym, basePrice) in initialFallbackPrices) {
            liveServerRates[sym] = basePrice
            liveDisplayedRates[sym] = basePrice
            val meta = getSymbolMeta(sym)
            val range = meta.pointSize * meta.defaultSpreadPoints * 12.0
            dailyExtrema[sym] = Pair(basePrice - range, basePrice + range)
        }
        for (sym in WATCHLIST_SYMBOLS) {
            val basePrice = initialFallbackPrices[sym] ?: 1.0
            val seededM1 = build14DayCandlesFromAnchors(sym, Timeframe.M1, basePrice, emptyList())
            val seededM5 = build14DayCandlesFromAnchors(sym, Timeframe.M5, basePrice, emptyList())
            val seededM15 = build14DayCandlesFromAnchors(sym, Timeframe.M15, basePrice, emptyList())
            candleAggregator.seedHistory(sym, Timeframe.M1, seededM1)
            candleAggregator.seedHistory(sym, Timeframe.M5, seededM5)
            candleAggregator.seedHistory(sym, Timeframe.M15, seededM15)

            val lastClose = seededM1.lastOrNull()?.close ?: basePrice
            liveServerRates[sym] = lastClose
            liveDisplayedRates[sym] = lastClose
            candleAggregator.onPriceTick(sym, lastClose, seedNow)
