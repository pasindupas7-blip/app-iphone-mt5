2.1 Market Schedule & Time Offset (SriLankaMarketHours.kt)
Kotlin
package com.example.data

import com.example.model.HistoryPeriod
import java.text.SimpleDateFormat
import java.util.Calendar
import java.util.Date
import java.util.Locale
import java.util.TimeZone

/**
 * Enforces the trading schedule in Sri Lanka Standard Time (Asia/Colombo, UTC+05:30):
 * - Market Opens: Monday 03:30 AM Sri Lanka Time
 * - Market Closes: Saturday 02:29 AM Sri Lanka Time (closed from 02:30 AM Saturday until 03:30 AM Monday)
 */
object SriLankaMarketHours {
    val SRI_LANKA_TIME_ZONE: TimeZone = TimeZone.getTimeZone("GMT+05:30")

    /**
     * Chart and trade execution clock runs 10 minutes behind real-world time (`now - 10 minutes`).
     */
    const val CHART_TIME_OFFSET_MS: Long = 10L * 60_000L

    // Minutes from 00:00 in Sri Lanka Time
    private const val MONDAY_OPEN_MINUTE_OF_DAY = 3 * 60 + 30    // 03:30 AM (210)
    private const val SATURDAY_CLOSE_MINUTE_OF_DAY = 2 * 60 + 29 // 02:29 AM inclusive (149)

    private val dateTimeLock = Any()

    fun chartNowMillis(wallClockNowMs: Long = System.currentTimeMillis()): Long {
        return wallClockNowMs - CHART_TIME_OFFSET_MS
    }

    fun isMarketOpen(timestampMs: Long = chartNowMillis()): Boolean {
        val cal = Calendar.getInstance(SRI_LANKA_TIME_ZONE, Locale.US)
        cal.timeInMillis = timestampMs
        val dayOfWeek = cal.get(Calendar.DAY_OF_WEEK)
        val hour = cal.get(Calendar.HOUR_OF_DAY)
        val minute = cal.get(Calendar.MINUTE)
        val minuteOfDay = hour * 60 + minute

        return when (dayOfWeek) {
            Calendar.SUNDAY -> false
            Calendar.MONDAY -> minuteOfDay >= MONDAY_OPEN_MINUTE_OF_DAY
            Calendar.TUESDAY,
            Calendar.WEDNESDAY,
            Calendar.THURSDAY,
            Calendar.FRIDAY -> true
            Calendar.SATURDAY -> minuteOfDay <= SATURDAY_CLOSE_MINUTE_OF_DAY
            else -> true
        }
    }

    fun clampToLastOpenMarketTimestamp(timestampMs: Long = chartNowMillis()): Long {
        if (isMarketOpen(timestampMs)) return timestampMs

        val cal = Calendar.getInstance(SRI_LANKA_TIME_ZONE, Locale.US)
        cal.timeInMillis = timestampMs
        val dayOfWeek = cal.get(Calendar.DAY_OF_WEEK)

        when (dayOfWeek) {
            Calendar.SATURDAY -> {
                cal.set(Calendar.HOUR_OF_DAY, 2)
                cal.set(Calendar.MINUTE, 29)
                cal.set(Calendar.SECOND, 0)
                cal.set(Calendar.MILLISECOND, 0)
            }
            Calendar.SUNDAY -> {
                cal.add(Calendar.DAY_OF_YEAR, -1)
                cal.set(Calendar.HOUR_OF_DAY, 2)
                cal.set(Calendar.MINUTE, 29)
                cal.set(Calendar.SECOND, 0)
                cal.set(Calendar.MILLISECOND, 0)
            }
            Calendar.MONDAY -> {
                cal.add(Calendar.DAY_OF_YEAR, -2)
                cal.set(Calendar.HOUR_OF_DAY, 2)
                cal.set(Calendar.MINUTE, 29)
                cal.set(Calendar.SECOND, 0)
                cal.set(Calendar.MILLISECOND, 0)
            }
        }
        return cal.timeInMillis
    }

    fun stepBackwardOpenMarketBucket(currentBucketMs: Long, intervalMs: Long): Long {
        val step = intervalMs.coerceAtLeast(60_000L)
        var candidate = currentBucketMs - step
        var safety = 0
        while (!isMarketOpen(candidate) && safety < 10_000) {
            candidate = clampToLastOpenMarketTimestamp(candidate)
            candidate = (candidate / step) * step
            if (!isMarketOpen(candidate)) {
                candidate -= step
            }
            safety++
        }
        return candidate
    }

    fun stepForwardOpenMarketBucket(currentBucketMs: Long, intervalMs: Long): Long {
        val step = intervalMs.coerceAtLeast(60_000L)
        var candidate = ((currentBucketMs / step) * step) + step
        var safety = 0
        while (!isMarketOpen(candidate) && safety < 10_000) {
            val cal = Calendar.getInstance(SRI_LANKA_TIME_ZONE, Locale.US)
            cal.timeInMillis = candidate
            when (cal.get(Calendar.DAY_OF_WEEK)) {
                Calendar.SATURDAY -> {
                    cal.add(Calendar.DAY_OF_YEAR, 2)
                    cal.set(Calendar.HOUR_OF_DAY, 3)
                    cal.set(Calendar.MINUTE, 30)
                    cal.set(Calendar.SECOND, 0)
                    cal.set(Calendar.MILLISECOND, 0)
                }
                Calendar.SUNDAY -> {
                    cal.add(Calendar.DAY_OF_YEAR, 1)
                    cal.set(Calendar.HOUR_OF_DAY, 3)
                    cal.set(Calendar.MINUTE, 30)
                    cal.set(Calendar.SECOND, 0)
                    cal.set(Calendar.MILLISECOND, 0)
                }
                Calendar.MONDAY -> {
                    cal.set(Calendar.HOUR_OF_DAY, 3)
                    cal.set(Calendar.MINUTE, 30)
                    cal.set(Calendar.SECOND, 0)
                    cal.set(Calendar.MILLISECOND, 0)
                }
                else -> {
                    cal.timeInMillis = candidate + step
                }
            }
            candidate = (cal.timeInMillis / step) * step
            if (!isMarketOpen(candidate)) {
                candidate += step
            }
            safety++
        }
        return candidate
    }

    fun buildOpenMarketTimestampsBetween(
        startExclusiveMs: Long,
        endExclusiveMs: Long,
        intervalMs: Long,
        maxSteps: Int = 5000
    ): LongArray {
        val step = intervalMs.coerceAtLeast(60_000L)
        if (endExclusiveMs - startExclusiveMs <= step) return LongArray(0)
        val list = ArrayList<Long>()
        var cursor = stepForwardOpenMarketBucket(startExclusiveMs, step)
        var count = 0
        while (cursor < endExclusiveMs && count < maxSteps) {
            if (isMarketOpen(cursor)) {
                list.add(cursor)
            }
            cursor = stepForwardOpenMarketBucket(cursor, step)
            count++
        }
        return list.toLongArray()
    }

    fun buildOpenMarketTimestamps(
        count: Int,
        intervalMs: Long,
        nowMs: Long = chartNowMillis()
    ): LongArray {
        if (count <= 0) return LongArray(0)
        val step = intervalMs.coerceAtLeast(60_000L)
        val clampedEnd = clampToLastOpenMarketTimestamp(nowMs)
        var cursor = (clampedEnd / step) * step
        if (!isMarketOpen(cursor)) {
            cursor = stepBackwardOpenMarketBucket(cursor, step)
        }

        val result = LongArray(count)
        for (i in (count - 1) downTo 0) {
            result[i] = cursor
            if (i > 0) {
                cursor = stepBackwardOpenMarketBucket(cursor, step)
            }
        }
        return result
    }

    fun parseMt5DateTimeMillis(dateTimeStr: String): Long {
        val trimmed = dateTimeStr.trim()
        if (trimmed.isEmpty()) return 0L
        return synchronized(dateTimeLock) {
            val patterns = listOf(
                "yyyy.MM.dd HH:mm:ss",
                "yyyy.MM.dd HH:mm",
                "yyyy-MM-dd HH:mm:ss",
                "yyyy-MM-dd HH:mm",
                "yyyy.MM.dd"
            )
            for (pattern in patterns) {
                try {
                    val sdf = SimpleDateFormat(pattern, Locale.US).apply {
                        timeZone = SRI_LANKA_TIME_ZONE
                        isLenient = true
                    }
                    val parsed = sdf.parse(trimmed)
                    if (parsed != null) return@synchronized parsed.time
                } catch (_: Exception) {
                }
            }
            0L
        }
    }

    fun formatHistoryTimestamp(timestampMs: Long = chartNowMillis()): String {
        val clamped = clampToLastOpenMarketTimestamp(timestampMs)
        return synchronized(dateTimeLock) {
            val sdf = SimpleDateFormat("yyyy.MM.dd HH:mm:ss", Locale.US).apply {
                timeZone = SRI_LANKA_TIME_ZONE
            }
            sdf.format(Date(clamped))
        }
    }

    fun formatPositionOpenTimestamp(timestampMs: Long = chartNowMillis()): String {
        val clamped = clampToLastOpenMarketTimestamp(timestampMs)
        return synchronized(dateTimeLock) {
            val sdf = SimpleDateFormat("yyyy.MM.dd HH:mm:ss", Locale.US).apply {
                timeZone = SRI_LANKA_TIME_ZONE
            }
            sdf.format(Date(clamped))
        }
    }
}
2.2 Real-Time OHLC Candlestick Aggregator (CandleAggregator.kt)
Kotlin
package com.example.data

import com.example.model.Candle
import com.example.model.Timeframe
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.util.concurrent.ConcurrentHashMap
import kotlin.math.max
import kotlin.math.min

/**
 * Aggregates real-time incoming Bid prices into authentic OHLC candlesticks for every symbol and timeframe.
 */
class CandleAggregator(
    private val maxCandlesPerSeries: Int = 7500
) {
    private val seriesMap = ConcurrentHashMap<String, MutableList<Candle>>()
    private val formatLock = Any()

    private val dailyFormat = SimpleDateFormat("dd MMM", Locale.US).apply {
        timeZone = SriLankaMarketHours.SRI_LANKA_TIME_ZONE
    }
    private val intradayFormat = SimpleDateFormat("dd MMM HH:mm", Locale.US).apply {
        timeZone = SriLankaMarketHours.SRI_LANKA_TIME_ZONE
    }

    private fun key(symbol: String, timeframe: Timeframe): String =
        "${symbol.uppercase(Locale.US)}_${timeframe.label}"

    fun hasHistory(symbol: String, timeframe: Timeframe): Boolean {
        val list = seriesMap[key(symbol, timeframe)]
        return list != null && list.size >= 10
    }

    fun seedHistory(symbol: String, timeframe: Timeframe, history: List<Candle>) {
        if (history.isEmpty()) return
        val k = key(symbol, timeframe)
        synchronized(this) {
            val existing = seriesMap[k]
            if (existing.isNullOrEmpty()) {
                seriesMap[k] = history.takeLast(maxCandlesPerSeries).toMutableList()
            } else {
                val liveLast = existing.last()
                val seeded = history.toMutableList()
                val lastSeeded = seeded.last()
                if (liveLast.timestamp > lastSeeded.timestamp) {
                    val connectedLive = liveLast.copy(
                        open = lastSeeded.close,
                        high = max(liveLast.high, max(lastSeeded.close, liveLast.close)),
                        low = min(liveLast.low, min(lastSeeded.close, liveLast.close))
                    )
                    seeded.add(connectedLive)
                } else if (liveLast.timestamp == lastSeeded.timestamp) {
                    val updatedClose = liveLast.close
                    seeded[seeded.lastIndex] = lastSeeded.copy(
                        high = max(lastSeeded.high, max(lastSeeded.open, updatedClose)),
                        low = min(lastSeeded.low, min(lastSeeded.open, updatedClose)),
                        close = updatedClose
                    )
                }
                seriesMap[k] = seeded.takeLast(maxCandlesPerSeries).toMutableList()
            }
        }
    }

    fun onPriceTick(
        symbol: String,
        bidPrice: Double,
        timestampMs: Long = SriLankaMarketHours.chartNowMillis()
    ) {
        if (bidPrice <= 0.0 || bidPrice.isNaN()) return
        if (!SriLankaMarketHours.isMarketOpen(timestampMs)) return

        synchronized(this) {
            for (tf in Timeframe.entries) {
                val k = key(symbol, tf)
                val list = seriesMap[k] ?: continue
                if (list.isEmpty()) continue

                val intervalMs = (tf.minutes * 60_000L).coerceAtLeast(60_000L)
                val bucketStart = (timestampMs / intervalMs) * intervalMs
                val lastCandle = list.last()
                val lastBucket = (lastCandle.timestamp / intervalMs) * intervalMs

                if (bucketStart <= lastBucket) {
                    val updated = lastCandle.copy(
                        high = max(lastCandle.high, bidPrice),
                        low = min(lastCandle.low, bidPrice),
                        close = bidPrice
                    )
                    list[list.lastIndex] = updated
                } else {
                    val openPrice = lastCandle.close
                    val newCandle = Candle(
                        time = formatTimestamp(bucketStart, tf),
                        timestamp = bucketStart,
                        open = openPrice,
                        high = max(openPrice, bidPrice),
                        low = min(openPrice, bidPrice),
                        close = bidPrice
                    )
                    list.add(newCandle)
                    if (list.size > maxCandlesPerSeries) {
                        list.removeAt(0)
                    }
                }
            }
        }
    }

    fun getCandles(symbol: String, timeframe: Timeframe): List<Candle> {
        synchronized(this) {
            return seriesMap[key(symbol, timeframe)]?.toList() ?: emptyList()
        }
    }

    fun clearAll() {
        synchronized(this) {
            seriesMap.clear()
        }
    }

    private fun formatTimestamp(timestampMs: Long, timeframe: Timeframe): String {
        return synchronized(formatLock) {
            val fmt = if (timeframe.minutes >= Timeframe.D1.minutes) dailyFormat else intradayFormat
            fmt.format(Date(timestampMs))
        }
    }
}
